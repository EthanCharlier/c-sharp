[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# -------------------------------------------------------------------
# Visual Studio cache / options directory
# -------------------------------------------------------------------
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
*.sln.iml

# -------------------------------------------------------------------
# Build outputs
# -------------------------------------------------------------------
*.dll
*.exe
*.pdb
*.cache
*.ilk
*.lib
*.meta
*.obj
*.iobj
*.pch
*.ipch
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# -------------------------------------------------------------------
# NuGet
# -------------------------------------------------------------------
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# -------------------------------------------------------------------
# JetBrains Rider / ReSharper
# -------------------------------------------------------------------
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# -------------------------------------------------------------------
# Visual Studio Code
# -------------------------------------------------------------------
.vscode/
*.code-workspace

# -------------------------------------------------------------------
# OS files
# -------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -------------------------------------------------------------------
# Test / Coverage
# -------------------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
TestResult.xml
nunit-*.xml

# -------------------------------------------------------------------
# Project-specific: ignore generated outputs and downloaded content
# -------------------------------------------------------------------

# Generated WebP outputs (regenerated on each run)
Outputs/
**/Outputs/
**/SequentialImages/
**/ParallelImages/

# Local benchmark images (often heavy — keep them out of the repo)
# Comment this line if you want to commit a sample image set
Images/
**/Images/

# Optional: keep a small sample folder in the repo
# !Images/sample/
# !Images/sample/*

# -------------------------------------------------------------------
# Sensitive data (never commit secrets!)
# -------------------------------------------------------------------
appsettings.*.json
!appsettings.json
!appsettings.Development.json
secrets.json
*.env
.env.local
.env.*.local

# -------------------------------------------------------------------
# Backup & temp files
# -------------------------------------------------------------------
*.bak
*.tmp
*.swp
*~
*.orig
